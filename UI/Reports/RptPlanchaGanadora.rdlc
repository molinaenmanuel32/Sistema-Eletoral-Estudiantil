            </ChartSeriesHierarchy>
            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="Series">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <!-- *** CORRECCIÓN: usar Porcentaje directamente (ya es % por plancha) *** -->
                        <Y>=Fields!Porcentaje.Value</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style>
                          <FontSize>8pt</FontSize>
                          <FontWeight>Bold</FontWeight>
