          <!-- GRÁFICO DE TORTA: Distribución % por Plancha       -->
          <!-- CORRECCIÓN PRINCIPAL: GroupExpression + Label real  -->
          <!-- ═══════════════════════════════════════════════════ -->
          <Chart Name="Chart4">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <!-- *** CORRECCIÓN: agrupar por NombrePlancha *** -->
                  <Group Name="ChartGroup_Plancha">
                    <GroupExpressions>
                      <GroupExpression>=Fields!NombrePlancha.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
