<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <DataSources>
    <DataSource Name="dsPlancha">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <!-- Datos de la plancha (cabecera) -->
    <DataSet Name="dsInfoPlancha">
      <Query>
        <DataSourceName>dsPlancha</DataSourceName>
        <CommandText>/* dsInfoPlancha */</CommandText>
      </Query>
      <Fields>
        <Field Name="PlanchaId">   <DataField>PlanchaId</DataField>   <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="Nombre">      <DataField>Nombre</DataField>      <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Descripcion"> <DataField>Descripcion</DataField> <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Mision">      <DataField>Mision</DataField>      <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Color">       <DataField>Color</DataField>       <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="AdminNombre"> <DataField>AdminNombre</DataField> <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Activa">      <DataField>Activa</DataField>      <rd:TypeName>System.Boolean</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- Miembros: MiembroPlancha -->
    <DataSet Name="dsMiembros">
      <Query>
        <DataSourceName>dsPlancha</DataSourceName>
        <CommandText>/* dsMiembros */</CommandText>
      </Query>
      <Fields>
        <Field Name="MiembroId">      <DataField>MiembroId</DataField>      <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="NombreCompleto"> <DataField>NombreCompleto</DataField> <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Matricula">      <DataField>Matricula</DataField>      <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Puesto">         <DataField>Puesto</DataField>         <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Descripcion">    <DataField>Descripcion</DataField>    <rd:TypeName>System.String</rd:TypeName> </Field>
        <Field Name="Orden">          <DataField>Orden</DataField>          <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="FotoPath">       <DataField>FotoPath</DataField>       <rd:TypeName>System.String</rd:TypeName> </Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="PlanchaId">
      <DataType>Integer</DataType>
      <DefaultValue><Values><Value>0</Value></Values></DefaultValue>
      <Prompt>ID de la Plancha</Prompt>
    </ReportParameter>
  </ReportParameters>

  <ReportSections>
    <ReportSection>
      <Body>
        <Height>24cm</Height>
        <ReportItems>

          <!-- ══════════════════════════════════════
               ENCABEZADO
               ══════════════════════════════════════ -->
          <Rectangle Name="rectHeader">
            <Left>0cm</Left><Top>0cm</Top><Width>19cm</Width><Height>2.5cm</Height>
            <Style><BackgroundColor>#1A365D</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="lblTituloReporte">
                <Left>0.3cm</Left><Top>0.3cm</Top><Width>18.4cm</Width><Height>0.9cm</Height>
                <Value>INTEGRANTES DE LA PLANCHA</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><VerticalAlign>Middle</VerticalAlign></Style>
              </Textbox>
              <!-- Nombre de la plancha desde el dataset de info -->
              <Textbox Name="lblNombrePlancha">
                <Left>0.3cm</Left><Top>1.3cm</Top><Width>18.4cm</Width><Height>0.8cm</Height>
                <DataSetName>dsInfoPlancha</DataSetName>
                <Value>=First(Fields!Nombre.Value,"dsInfoPlancha")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>13pt</FontSize><Color>#90CDF4</Color><VerticalAlign>Middle</VerticalAlign></Style>
              </Textbox>
            </ReportItems>
          </Rectangle>

          <!-- Fecha -->
          <Textbox Name="lblFecha">
            <Left>0cm</Left><Top>2.7cm</Top><Width>19cm</Width><Height>0.5cm</Height>
            <Value>=Format(Now(),"dddd, dd 'de' MMMM 'de' yyyy")</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#718096</Color><TextAlign>Right</TextAlign></Style>
          </Textbox>

          <!-- ══════════════════════════════════════
               DATOS DE LA PLANCHA (card info)
               ══════════════════════════════════════ -->
          <Rectangle Name="rectInfo">
            <Left>0cm</Left><Top>3.4cm</Top><Width>19cm</Width><Height>3cm</Height>
            <Style><BackgroundColor>#EBF8FF</BackgroundColor><BorderStyle><Default>Solid</Default></BorderStyle><BorderColor><Default>#BEE3F8</Default></BorderColor></Style>
            <ReportItems>
              <!-- Etiquetas -->
              <Textbox Name="lDescLabel"><Left>0.3cm</Left><Top>0.2cm</Top><Width>3cm</Width><Height>0.5cm</Height>
                <Value>Descripción:</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C5282</Color></Style></Textbox>
              <Textbox Name="lDescVal"><Left>3.5cm</Left><Top>0.2cm</Top><Width>15.2cm</Width><Height>0.5cm</Height>
                <DataSetName>dsInfoPlancha</DataSetName>
                <Value>=First(Fields!Descripcion.Value,"dsInfoPlancha")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#2D3748</Color></Style></Textbox>

              <Textbox Name="lMisionLabel"><Left>0.3cm</Left><Top>0.85cm</Top><Width>3cm</Width><Height>0.5cm</Height>
                <Value>Misión:</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C5282</Color></Style></Textbox>
              <Textbox Name="lMisionVal"><Left>3.5cm</Left><Top>0.85cm</Top><Width>15.2cm</Width><Height>0.8cm</Height>
                <DataSetName>dsInfoPlancha</DataSetName>
                <Value>=First(Fields!Mision.Value,"dsInfoPlancha")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#2D3748</Color><CanGrow>true</CanGrow></Style></Textbox>

              <Textbox Name="lAdminLabel"><Left>0.3cm</Left><Top>1.8cm</Top><Width>3cm</Width><Height>0.5cm</Height>
                <Value>Administrador:</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C5282</Color></Style></Textbox>
              <Textbox Name="lAdminVal"><Left>3.5cm</Left><Top>1.8cm</Top><Width>7cm</Width><Height>0.5cm</Height>
                <DataSetName>dsInfoPlancha</DataSetName>
                <Value>=First(Fields!AdminNombre.Value,"dsInfoPlancha")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#2D3748</Color></Style></Textbox>

              <Textbox Name="lColorLabel"><Left>10.5cm</Left><Top>1.8cm</Top><Width>2.5cm</Width><Height>0.5cm</Height>
                <Value>Color:</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C5282</Color></Style></Textbox>
              <Textbox Name="lColorVal"><Left>13.2cm</Left><Top>1.8cm</Top><Width>5.5cm</Width><Height>0.5cm</Height>
                <DataSetName>dsInfoPlancha</DataSetName>
                <Value>=First(Fields!Color.Value,"dsInfoPlancha")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#2D3748</Color></Style></Textbox>

              <Textbox Name="lActivaLabel"><Left>0.3cm</Left><Top>2.4cm</Top><Width>3cm</Width><Height>0.5cm</Height>
                <Value>Estado:</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C5282</Color></Style></Textbox>
              <Textbox Name="lActivaVal"><Left>3.5cm</Left><Top>2.4cm</Top><Width>4cm</Width><Height>0.5cm</Height>
                <DataSetName>dsInfoPlancha</DataSetName>
                <Value>=IIF(First(Fields!Activa.Value,"dsInfoPlancha"),"✔ Activa","✖ Inactiva")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize>
                  <Color>=IIF(First(Fields!Activa.Value,"dsInfoPlancha"),"#276749","#C53030")</Color>
                  <FontWeight>Bold</FontWeight></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <!-- ══════════════════════════════════════
               TABLA DE MIEMBROS
               ══════════════════════════════════════ -->
          <Textbox Name="lblSeccionMiembros">
            <Left>0cm</Left><Top>6.7cm</Top><Width>19cm</Width><Height>0.65cm</Height>
            <Value>👥  INTEGRANTES</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>13pt</FontSize><FontWeight>Bold</FontWeight><Color>#2D3748</Color>
              <BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderColor><Bottom>#E2E8F0</Bottom></BorderColor><BorderWidth><Bottom>1pt</Bottom></BorderWidth></Style>
          </Textbox>

          <Tablix Name="tblMiembros">
            <DataSetName>dsMiembros</DataSetName>
            <Left>0cm</Left><Top>7.5cm</Top><Width>19cm</Width>
            <SortExpressions>
              <SortExpression><Value>=Fields!Orden.Value</Value></SortExpression>
            </SortExpressions>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>0.8cm</Width></TablixColumn>
                <TablixColumn><Width>5.5cm</Width></TablixColumn>
                <TablixColumn><Width>2.8cm</Width></TablixColumn>
                <TablixColumn><Width>4cm</Width></TablixColumn>
                <TablixColumn><Width>5.9cm</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- Encabezado -->
                <TablixRow>
                  <Height>0.75cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="hMOrd"><Value>#</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#1A365D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hMNombre"><Value>Nombre Completo</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#1A365D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hMMatricula"><Value>Matrícula</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#1A365D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hMPuesto"><Value>Puesto / Cargo</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#1A365D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hMDesc"><Value>Descripción</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#1A365D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Datos -->
                <TablixRow>
                  <Height>0.8cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="dMOrd"><Value>=Fields!Orden.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#EBF8FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dMNombre"><Value>=Fields!NombreCompleto.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#EBF8FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dMMatricula"><Value>=Fields!Matricula.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#EBF8FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dMPuesto"><Value>=Fields!Puesto.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#EBF8FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dMDesc"><Value>=Fields!Descripcion.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign><CanGrow>true</CanGrow><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#EBF8FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <!-- Fila Total -->
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember><TablixHeader><Size>1cm</Size><CellContents><Textbox Name="hdrMiembro"><Value>Integrante</Value><Style><FontWeight>Bold</FontWeight></Style></Textbox></CellContents></TablixHeader><KeepWithGroup>After</KeepWithGroup></TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
          </Tablix>

          <!-- Total de miembros -->
          <Textbox Name="lblTotal">
            <Left>0cm</Left><Top>17cm</Top><Width>19cm</Width><Height>0.6cm</Height>
            <Value>="Total de integrantes: " &amp; CountRows("dsMiembros")</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#2D3748</Color><TextAlign>Right</TextAlign></Style>
          </Textbox>

        </ReportItems>
      </Body>

      <PageFooter>
        <Height>0.8cm</Height>
        <PrintOnFirstPage>true</PrintOnFirstPage>
        <PrintOnLastPage>true</PrintOnLastPage>
        <ReportItems>
          <Textbox Name="footLeft">
            <Left>0cm</Left><Top>0.1cm</Top><Width>9.5cm</Width><Height>0.5cm</Height>
            <Value>Sistema de Votación Estudiantil</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#718096</Color></Style>
          </Textbox>
          <Textbox Name="footRight">
            <Left>9.5cm</Left><Top>0.1cm</Top><Width>9.5cm</Width><Height>0.5cm</Height>
            <Value>="Página " &amp; Globals!PageNumber &amp; " de " &amp; Globals!TotalPages</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#718096</Color><TextAlign>Right</TextAlign></Style>
          </Textbox>
        </ReportItems>
      </PageFooter>

      <Page>
        <PageWidth>21.59cm</PageWidth><PageHeight>27.94cm</PageHeight>
        <LeftMargin>1.3cm</LeftMargin><RightMargin>1.3cm</RightMargin>
        <TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>

  <rd:ReportID>a1b2c3d4-0002-0002-0002-000000000002</rd:ReportID>
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
</Report>
