<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <DataSources>
    <DataSource Name="dsVotos">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <!-- Resumen general: EstadisticasVotacion -->
    <DataSet Name="dsResumen">
      <Query>
        <DataSourceName>dsVotos</DataSourceName>
        <CommandText>/* dsResumen */</CommandText>
      </Query>
      <Fields>
        <Field Name="TotalPadron">             <DataField>TotalPadron</DataField>             <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="TotalVotos">              <DataField>TotalVotos</DataField>              <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="VotosNulos">              <DataField>VotosNulos</DataField>              <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="VotosValidos">            <DataField>VotosValidos</DataField>            <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="SinVotar">               <DataField>SinVotar</DataField>               <rd:TypeName>System.Int32</rd:TypeName>  </Field>
        <Field Name="PorcentajeParticipacion"><DataField>PorcentajeParticipacion</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- Detalle de votos individuales: JOIN Voto + Padron + Plancha -->
    <DataSet Name="dsDetalleVotos">
      <Query>
        <DataSourceName>dsVotos</DataSourceName>
        <CommandText>/* dsDetalleVotos */</CommandText>
      </Query>
      <Fields>
        <Field Name="VotoId">         <DataField>VotoId</DataField>         <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="NombreVotante">  <DataField>NombreVotante</DataField>  <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Matricula">      <DataField>Matricula</DataField>      <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Curso">          <DataField>Curso</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Seccion">        <DataField>Seccion</DataField>        <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="PlanChaNombre">  <DataField>PlanchaNombre</DataField>  <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="EsNulo">         <DataField>EsNulo</DataField>         <rd:TypeName>System.Boolean</rd:TypeName>  </Field>
        <Field Name="FechaVoto">      <DataField>FechaVoto</DataField>      <rd:TypeName>System.DateTime</rd:TypeName> </Field>
      </Fields>
    </DataSet>

    <!-- Por plancha: EstadisticaPlancha -->
    <DataSet Name="dsPorPlancha">
      <Query>
        <DataSourceName>dsVotos</DataSourceName>
        <CommandText>/* dsPorPlancha */</CommandText>
      </Query>
      <Fields>
        <Field Name="Plancha">    <DataField>Plancha</DataField>    <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="TotalVotos"> <DataField>TotalVotos</DataField> <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="Porcentaje"> <DataField>Porcentaje</DataField> <rd:TypeName>System.Decimal</rd:TypeName> </Field>
        <Field Name="Color">      <DataField>Color</DataField>      <rd:TypeName>System.String</rd:TypeName>  </Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="TituloVotacion">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>Elecciones Estudiantiles</Value></Values></DefaultValue>
      <Prompt>Título de la Votación</Prompt>
    </ReportParameter>
    <ReportParameter Name="FechaInicio">
      <DataType>DateTime</DataType>
      <Prompt>Fecha Inicio</Prompt>
    </ReportParameter>
    <ReportParameter Name="FechaFin">
      <DataType>DateTime</DataType>
      <Prompt>Fecha Fin</Prompt>
    </ReportParameter>
  </ReportParameters>

  <ReportSections>
    <ReportSection>
      <Body>
        <Height>26cm</Height>
        <ReportItems>

          <!-- ENCABEZADO -->
          <Rectangle Name="rectHeader">
            <Left>0cm</Left><Top>0cm</Top><Width>19cm</Width><Height>2.5cm</Height>
            <Style><BackgroundColor>#22543D</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="lblTitulo">
                <Left>0.3cm</Left><Top>0.3cm</Top><Width>18.4cm</Width><Height>0.9cm</Height>
                <Value>REPORTE GENERAL DE VOTOS</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><VerticalAlign>Middle</VerticalAlign></Style>
              </Textbox>
              <Textbox Name="lblSubtitulo">
                <Left>0.3cm</Left><Top>1.3cm</Top><Width>18.4cm</Width><Height>0.8cm</Height>
                <Value>=Parameters!TituloVotacion.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><Color>#9AE6B4</Color><VerticalAlign>Middle</VerticalAlign></Style>
              </Textbox>
            </ReportItems>
          </Rectangle>

          <!-- Rango de fechas + fecha reporte -->
          <Textbox Name="lblRango">
            <Left>0cm</Left><Top>2.7cm</Top><Width>13cm</Width><Height>0.5cm</Height>
            <Value>="Período: " &amp; Format(Parameters!FechaInicio.Value,"dd/MM/yyyy") &amp; "  →  " &amp; Format(Parameters!FechaFin.Value,"dd/MM/yyyy")</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><Color>#4A5568</Color></Style>
          </Textbox>
          <Textbox Name="lblFechaGen">
            <Left>13cm</Left><Top>2.7cm</Top><Width>6cm</Width><Height>0.5cm</Height>
            <Value>=Format(Now(),"dd/MM/yyyy HH:mm")</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#718096</Color><TextAlign>Right</TextAlign></Style>
          </Textbox>

          <!-- ══════════════════════════════════════
               KPI CARDS (5 indicadores)
               ══════════════════════════════════════ -->
          <Rectangle Name="kpi1">
            <Left>0cm</Left><Top>3.5cm</Top><Width>3.6cm</Width><Height>1.8cm</Height>
            <Style><BackgroundColor>#E6FFFA</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="k1L"><Left>0.2cm</Left><Top>0.15cm</Top><Width>3.2cm</Width><Height>0.5cm</Height><Value>Padrón Total</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#234E52</Color></Style></Textbox>
              <Textbox Name="k1V"><Left>0.2cm</Left><Top>0.6cm</Top><Width>3.2cm</Width><Height>0.9cm</Height><DataSetName>dsResumen</DataSetName><Value>=First(Fields!TotalPadron.Value,"dsResumen")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#234E52</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <Rectangle Name="kpi2">
            <Left>3.85cm</Left><Top>3.5cm</Top><Width>3.6cm</Width><Height>1.8cm</Height>
            <Style><BackgroundColor>#F0FFF4</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="k2L"><Left>0.2cm</Left><Top>0.15cm</Top><Width>3.2cm</Width><Height>0.5cm</Height><Value>Total Votos</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#276749</Color></Style></Textbox>
              <Textbox Name="k2V"><Left>0.2cm</Left><Top>0.6cm</Top><Width>3.2cm</Width><Height>0.9cm</Height><DataSetName>dsResumen</DataSetName><Value>=First(Fields!TotalVotos.Value,"dsResumen")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#276749</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <Rectangle Name="kpi3">
            <Left>7.7cm</Left><Top>3.5cm</Top><Width>3.6cm</Width><Height>1.8cm</Height>
            <Style><BackgroundColor>#FFFFF0</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="k3L"><Left>0.2cm</Left><Top>0.15cm</Top><Width>3.2cm</Width><Height>0.5cm</Height><Value>Votos Válidos</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#744210</Color></Style></Textbox>
              <Textbox Name="k3V"><Left>0.2cm</Left><Top>0.6cm</Top><Width>3.2cm</Width><Height>0.9cm</Height><DataSetName>dsResumen</DataSetName><Value>=First(Fields!VotosValidos.Value,"dsResumen")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#744210</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <Rectangle Name="kpi4">
            <Left>11.55cm</Left><Top>3.5cm</Top><Width>3.6cm</Width><Height>1.8cm</Height>
            <Style><BackgroundColor>#FFF5F5</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="k4L"><Left>0.2cm</Left><Top>0.15cm</Top><Width>3.2cm</Width><Height>0.5cm</Height><Value>Votos Nulos</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#C53030</Color></Style></Textbox>
              <Textbox Name="k4V"><Left>0.2cm</Left><Top>0.6cm</Top><Width>3.2cm</Width><Height>0.9cm</Height><DataSetName>dsResumen</DataSetName><Value>=First(Fields!VotosNulos.Value,"dsResumen")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#C53030</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <Rectangle Name="kpi5">
            <Left>15.4cm</Left><Top>3.5cm</Top><Width>3.6cm</Width><Height>1.8cm</Height>
            <Style><BackgroundColor>#EBF8FF</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="k5L"><Left>0.2cm</Left><Top>0.15cm</Top><Width>3.2cm</Width><Height>0.5cm</Height><Value>% Participación</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#2B6CB0</Color></Style></Textbox>
              <Textbox Name="k5V"><Left>0.2cm</Left><Top>0.6cm</Top><Width>3.2cm</Width><Height>0.9cm</Height><DataSetName>dsResumen</DataSetName>
                <Value>=Format(First(Fields!PorcentajeParticipacion.Value,"dsResumen"),"0.0") &amp; "%"</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>20pt</FontSize><FontWeight>Bold</FontWeight><Color>#2B6CB0</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <!-- SIN VOTAR -->
          <Rectangle Name="kpi6">
            <Left>0cm</Left><Top>5.5cm</Top><Width>3.6cm</Width><Height>1.2cm</Height>
            <Style><BackgroundColor>#FAF5FF</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="k6L"><Left>0.2cm</Left><Top>0.1cm</Top><Width>3.2cm</Width><Height>0.4cm</Height><Value>Sin Votar</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#553C9A</Color></Style></Textbox>
              <Textbox Name="k6V"><Left>0.2cm</Left><Top>0.55cm</Top><Width>3.2cm</Width><Height>0.5cm</Height><DataSetName>dsResumen</DataSetName><Value>=First(Fields!SinVotar.Value,"dsResumen")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#553C9A</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <!-- ══════════════════════════════════════
               TABLA POR PLANCHA
               ══════════════════════════════════════ -->
          <Textbox Name="lblSecPlancha">
            <Left>0cm</Left><Top>7.1cm</Top><Width>19cm</Width><Height>0.65cm</Height>
            <Value>📊  VOTOS POR PLANCHA</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#2D3748</Color>
              <BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderColor><Bottom>#E2E8F0</Bottom></BorderColor><BorderWidth><Bottom>1pt</Bottom></BorderWidth></Style>
          </Textbox>

          <Tablix Name="tblPorPlancha">
            <DataSetName>dsPorPlancha</DataSetName>
            <Left>0cm</Left><Top>7.9cm</Top><Width>19cm</Width>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>8cm</Width></TablixColumn>
                <TablixColumn><Width>3cm</Width></TablixColumn>
                <TablixColumn><Width>3cm</Width></TablixColumn>
                <TablixColumn><Width>5cm</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>0.7cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="hPPNombre"><Value>Plancha</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#22543D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hPPColor"><Value>Color</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#22543D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hPPVotos"><Value>Votos</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#22543D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hPPPct"><Value>Porcentaje</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#22543D</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.75cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="dPPNombre"><Value>=Fields!Plancha.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F0FFF4","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dPPColor"><Value>=Fields!Color.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F0FFF4","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dPPVotos"><Value>=Fields!TotalVotos.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F0FFF4","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dPPPct">
                      <Value>=Format(Fields!Porcentaje.Value,"0.00") &amp; "%"</Value>
                      <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#276749</Color><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F0FFF4","White")</BackgroundColor></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
          </Tablix>

          <!-- ══════════════════════════════════════
               DETALLE DE VOTOS INDIVIDUALES
               ══════════════════════════════════════ -->
          <Textbox Name="lblSecDetalle">
            <Left>0cm</Left><Top>11.3cm</Top><Width>19cm</Width><Height>0.65cm</Height>
            <Value>🗳️  DETALLE DE VOTOS EMITIDOS</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#2D3748</Color>
              <BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderColor><Bottom>#E2E8F0</Bottom></BorderColor><BorderWidth><Bottom>1pt</Bottom></BorderWidth></Style>
          </Textbox>

          <Tablix Name="tblDetalle">
            <DataSetName>dsDetalleVotos</DataSetName>
            <Left>0cm</Left><Top>12.1cm</Top><Width>19cm</Width>
            <SortExpressions>
              <SortExpression><Value>=Fields!FechaVoto.Value</Value></SortExpression>
            </SortExpressions>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>0.8cm</Width></TablixColumn>
                <TablixColumn><Width>4.7cm</Width></TablixColumn>
                <TablixColumn><Width>2.5cm</Width></TablixColumn>
                <TablixColumn><Width>2cm</Width></TablixColumn>
                <TablixColumn><Width>1.5cm</Width></TablixColumn>
                <TablixColumn><Width>3.7cm</Width></TablixColumn>
                <TablixColumn><Width>1.8cm</Width></TablixColumn>
                <TablixColumn><Width>2cm</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- Header -->
                <TablixRow>
                  <Height>0.7cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="hD0"><Value>#</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hD1"><Value>Votante</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><PaddingLeft>4pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hD2"><Value>Matrícula</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hD3"><Value>Curso</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hD4"><Value>Secc.</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hD5"><Value>Plancha Votada</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><PaddingLeft>4pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hD6"><Value>Nulo</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hD7"><Value>Hora</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#2D3748</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Data row -->
                <TablixRow>
                  <Height>0.65cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="dD0"><Value>=RowNumber(Nothing)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dD1"><Value>=Fields!NombreVotante.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><PaddingLeft>4pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dD2"><Value>=Fields!Matricula.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dD3"><Value>=Fields!Curso.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dD4"><Value>=Fields!Seccion.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dD5">
                      <Value>=IIF(Fields!EsNulo.Value,"— VOTO NULO —",Fields!PlanChaNombre.Value)</Value>
                      <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>4pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                        <Color>=IIF(Fields!EsNulo.Value,"#C53030","#276749")</Color>
                        <BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor>
                      </Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dD6">
                      <Value>=IIF(Fields!EsNulo.Value,"Sí","No")</Value>
                      <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign>
                        <Color>=IIF(Fields!EsNulo.Value,"#C53030","#276749")</Color>
                        <BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor>
                      </Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dD7"><Value>=Format(Fields!FechaVoto.Value,"HH:mm:ss")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#F7FAFC","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
          </Tablix>

          <!-- Total votos -->
          <Textbox Name="lblTotalDetalle">
            <Left>0cm</Left><Top>24.5cm</Top><Width>19cm</Width><Height>0.6cm</Height>
            <Value>="Total de registros: " &amp; CountRows("dsDetalleVotos")</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#2D3748</Color><TextAlign>Right</TextAlign></Style>
          </Textbox>

