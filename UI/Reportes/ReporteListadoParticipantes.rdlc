<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <DataSources>
    <DataSource Name="dsPadron">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <!-- Padrón completo: Padron + estado de voto -->
    <DataSet Name="dsParticipantes">
      <Query>
        <DataSourceName>dsPadron</DataSourceName>
        <CommandText>/* dsParticipantes */</CommandText>
      </Query>
      <Fields>
        <Field Name="PadronId">       <DataField>PadronId</DataField>       <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="NombreCompleto"> <DataField>NombreCompleto</DataField> <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="Matricula">      <DataField>Matricula</DataField>      <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="Curso">          <DataField>Curso</DataField>          <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="Seccion">        <DataField>Seccion</DataField>        <rd:TypeName>System.String</rd:TypeName>  </Field>
        <!-- Calculado en la capa de datos: "Votó" / "Pendiente" -->
        <Field Name="EstadoVoto">     <DataField>EstadoVoto</DataField>     <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="HoraVoto">       <DataField>HoraVoto</DataField>       <rd:TypeName>System.String</rd:TypeName>  </Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="TituloVotacion">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>Elecciones Estudiantiles</Value></Values></DefaultValue>
      <Prompt>Título de la Votación</Prompt>
    </ReportParameter>
    <ReportParameter Name="FiltroEstado">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>Todos</Value></Values></DefaultValue>
      <Prompt>Filtrar por Estado (Todos / Votó / Pendiente)</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue><Value>Todos</Value><Label>Todos</Label></ParameterValue>
          <ParameterValue><Value>Votó</Value><Label>Solo votantes</Label></ParameterValue>
          <ParameterValue><Value>Pendiente</Value><Label>Solo pendientes</Label></ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="FiltroCurso">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <DefaultValue><Values><Value></Value></Values></DefaultValue>
      <Prompt>Filtrar por Curso (dejar vacío = todos)</Prompt>
    </ReportParameter>
  </ReportParameters>

  <ReportSections>
    <ReportSection>
      <Body>
        <Height>24cm</Height>
        <ReportItems>

          <!-- ══════════════════════════════════════
               ENCABEZADO
               ══════════════════════════════════════ -->
          <Rectangle Name="rectHeader">
            <Left>0cm</Left><Top>0cm</Top><Width>19cm</Width><Height>2.5cm</Height>
            <Style><BackgroundColor>#44337A</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="lblTitulo">
                <Left>0.3cm</Left><Top>0.3cm</Top><Width>18.4cm</Width><Height>0.9cm</Height>
                <Value>LISTADO GENERAL DE PARTICIPANTES</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><VerticalAlign>Middle</VerticalAlign></Style>
              </Textbox>
              <Textbox Name="lblSubtitulo">
                <Left>0.3cm</Left><Top>1.3cm</Top><Width>18.4cm</Width><Height>0.8cm</Height>
                <Value>=Parameters!TituloVotacion.Value</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><Color>#D6BCFA</Color><VerticalAlign>Middle</VerticalAlign></Style>
              </Textbox>
            </ReportItems>
          </Rectangle>

          <!-- Metadatos del reporte -->
          <Textbox Name="lblMeta">
            <Left>0cm</Left><Top>2.7cm</Top><Width>13cm</Width><Height>0.5cm</Height>
            <Value>="Estado: " &amp; Parameters!FiltroEstado.Value &amp;
                   "   |   Curso: " &amp; IIF(Parameters!FiltroCurso.Value = "","Todos",Parameters!FiltroCurso.Value)</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><Color>#4A5568</Color></Style>
          </Textbox>
          <Textbox Name="lblFechaGen">
            <Left>13cm</Left><Top>2.7cm</Top><Width>6cm</Width><Height>0.5cm</Height>
            <Value>=Format(Now(),"dd/MM/yyyy HH:mm")</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#718096</Color><TextAlign>Right</TextAlign></Style>
          </Textbox>

          <!-- ══════════════════════════════════════
               KPI: TOTALES
               ══════════════════════════════════════ -->
          <Rectangle Name="cardTotal">
            <Left>0cm</Left><Top>3.5cm</Top><Width>4.5cm</Width><Height>1.6cm</Height>
            <Style><BackgroundColor>#FAF5FF</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="cTL"><Left>0.2cm</Left><Top>0.1cm</Top><Width>4cm</Width><Height>0.4cm</Height>
                <Value>Total en Padrón</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#44337A</Color></Style></Textbox>
              <Textbox Name="cTV"><Left>0.2cm</Left><Top>0.55cm</Top><Width>4cm</Width><Height>0.8cm</Height>
                <Value>=CountRows("dsParticipantes")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#44337A</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <Rectangle Name="cardVotaron">
            <Left>4.75cm</Left><Top>3.5cm</Top><Width>4.5cm</Width><Height>1.6cm</Height>
            <Style><BackgroundColor>#F0FFF4</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="cVL"><Left>0.2cm</Left><Top>0.1cm</Top><Width>4cm</Width><Height>0.4cm</Height>
                <Value>Ya Votaron</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#276749</Color></Style></Textbox>
              <Textbox Name="cVV"><Left>0.2cm</Left><Top>0.55cm</Top><Width>4cm</Width><Height>0.8cm</Height>
                <Value>=CountIf(Fields!EstadoVoto.Value = "Votó", "dsParticipantes")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#276749</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <Rectangle Name="cardPendientes">
            <Left>9.5cm</Left><Top>3.5cm</Top><Width>4.5cm</Width><Height>1.6cm</Height>
            <Style><BackgroundColor>#FFF5F5</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="cPL"><Left>0.2cm</Left><Top>0.1cm</Top><Width>4cm</Width><Height>0.4cm</Height>
                <Value>Pendientes</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#C53030</Color></Style></Textbox>
              <Textbox Name="cPV"><Left>0.2cm</Left><Top>0.55cm</Top><Width>4cm</Width><Height>0.8cm</Height>
                <Value>=CountIf(Fields!EstadoVoto.Value = "Pendiente", "dsParticipantes")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#C53030</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <Rectangle Name="cardPorcentaje">
            <Left>14.25cm</Left><Top>3.5cm</Top><Width>4.75cm</Width><Height>1.6cm</Height>
            <Style><BackgroundColor>#EBF8FF</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="cPcL"><Left>0.2cm</Left><Top>0.1cm</Top><Width>4.3cm</Width><Height>0.4cm</Height>
                <Value>% Participación</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#2B6CB0</Color></Style></Textbox>
              <Textbox Name="cPcV"><Left>0.2cm</Left><Top>0.55cm</Top><Width>4.3cm</Width><Height>0.8cm</Height>
                <Value>=Format(
                    IIF(CountRows("dsParticipantes") = 0, 0,
                        CountIf(Fields!EstadoVoto.Value = "Votó", "dsParticipantes") /
                        CountRows("dsParticipantes") * 100), "0.0") &amp; "%"</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>20pt</FontSize><FontWeight>Bold</FontWeight><Color>#2B6CB0</Color></Style></Textbox>
            </ReportItems>
          </Rectangle>

          <!-- ══════════════════════════════════════
               TABLA DE PARTICIPANTES (PADRÓN)
               ══════════════════════════════════════ -->
          <Textbox Name="lblSecPadron">
            <Left>0cm</Left><Top>5.4cm</Top><Width>19cm</Width><Height>0.65cm</Height>
            <Value>📋  PADRÓN ELECTORAL</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#2D3748</Color>
              <BorderStyle><Bottom>Solid</Bottom></BorderStyle><BorderColor><Bottom>#E2E8F0</Bottom></BorderColor><BorderWidth><Bottom>1pt</Bottom></BorderWidth></Style>
          </Textbox>

          <Tablix Name="tblPadron">
            <DataSetName>dsParticipantes</DataSetName>
            <Left>0cm</Left><Top>6.2cm</Top><Width>19cm</Width>

            <!-- Filtro aplicado en expresión de visibilidad de filas -->
            <Filters>
              <Filter>
                <FilterExpression>
                  =IIF(Parameters!FiltroEstado.Value = "Todos", True,
                   IIF(Fields!EstadoVoto.Value = Parameters!FiltroEstado.Value, True, False))
                </FilterExpression>
                <Operator>Equal</Operator>
                <FilterValues><FilterValue>=True</FilterValue></FilterValues>
              </Filter>
            </Filters>

            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>0.8cm</Width></TablixColumn>
                <TablixColumn><Width>5.5cm</Width></TablixColumn>
                <TablixColumn><Width>2.8cm</Width></TablixColumn>
                <TablixColumn><Width>2.5cm</Width></TablixColumn>
                <TablixColumn><Width>1.6cm</Width></TablixColumn>
                <TablixColumn><Width>3cm</Width></TablixColumn>
                <TablixColumn><Width>2.8cm</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- Encabezado -->
                <TablixRow>
                  <Height>0.75cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="hP0"><Value>#</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#44337A</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hP1"><Value>Nombre Completo</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#44337A</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><PaddingLeft>5pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hP2"><Value>Matrícula</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#44337A</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hP3"><Value>Curso</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#44337A</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hP4"><Value>Sección</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#44337A</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hP5"><Value>Estado</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#44337A</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hP6"><Value>Hora Voto</Value><Style><FontWeight>Bold</FontWeight><BackgroundColor>#44337A</BackgroundColor><Color>White</Color><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Datos -->
                <TablixRow>
                  <Height>0.7cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="dP0"><Value>=RowNumber(Nothing)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#FAF5FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dP1"><Value>=Fields!NombreCompleto.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><PaddingLeft>5pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#FAF5FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dP2"><Value>=Fields!Matricula.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#FAF5FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dP3"><Value>=Fields!Curso.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#FAF5FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dP4"><Value>=Fields!Seccion.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#FAF5FF","White")</BackgroundColor></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dP5">
                      <Value>=Fields!EstadoVoto.Value</Value>
                      <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign>
                        <Color>=IIF(Fields!EstadoVoto.Value = "Votó","#276749","#C53030")</Color>
                        <BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#FAF5FF","White")</BackgroundColor>
                      </Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dP6">
                      <Value>=IIF(Fields!HoraVoto.Value = "" OR IsNothing(Fields!HoraVoto.Value), "—", Fields!HoraVoto.Value)</Value>
                      <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><Color>#4A5568</Color><BackgroundColor>=IIF(RowNumber(Nothing) Mod 2=0,"#FAF5FF","White")</BackgroundColor></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>

            <!-- AGRUPACIÓN POR CURSO (sub-encabezado) -->
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <Group Name="GrupoCurso">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Curso.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <TablixHeader>
                    <Size>0.7cm</Size>
                    <CellContents>
                      <Textbox Name="hdrCurso">
                        <Value>="Curso: " &amp; Fields!Curso.Value &amp; "  —  Sección: " &amp; Fields!Seccion.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight>
                          <BackgroundColor>#EDE9F6</BackgroundColor><Color>#44337A</Color>
                          <PaddingLeft>6pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style>
                      </Textbox>
                    </CellContents>
                  </TablixHeader>
                  <TablixMembers>
                    <TablixMember></TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>

          </Tablix>

          <!-- Firma / sello -->
          <Rectangle Name="rectFirma">
            <Left>12cm</Left><Top>21cm</Top><Width>7cm</Width><Height>2cm</Height>
            <Style><BorderStyle><Top>Solid</Top></BorderStyle><BorderColor><Top>#CBD5E0</Top></BorderColor></Style>
            <ReportItems>
              <Textbox Name="lblFirmaLabel">
                <Left>0cm</Left><Top>0.1cm</Top><Width>7cm</Width><Height>0.5cm</Height>
                <Value>Firma Responsable del Proceso</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#718096</Color><TextAlign>Center</TextAlign></Style>
              </Textbox>
              <Textbox Name="lblFirmaLinea">
                <Left>0.5cm</Left><Top>1.1cm</Top><Width>6cm</Width><Height>0.3cm</Height>
                <Value>__________________________________</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#CBD5E0</Color><TextAlign>Center</TextAlign></Style>
              </Textbox>
            </ReportItems>
          </Rectangle>

        </ReportItems>
      </Body>

      <PageFooter>
        <Height>0.8cm</Height>
        <PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage>
        <ReportItems>
          <Textbox Name="footLeft3"><Left>0cm</Left><Top>0.1cm</Top><Width>9.5cm</Width><Height>0.5cm</Height>
            <Value>="Padrón Electoral — " &amp; Parameters!TituloVotacion.Value</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#718096</Color></Style></Textbox>
          <Textbox Name="footRight3"><Left>9.5cm</Left><Top>0.1cm</Top><Width>9.5cm</Width><Height>0.5cm</Height>
            <Value>="Página " &amp; Globals!PageNumber &amp; " de " &amp; Globals!TotalPages</Value>
            <Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#718096</Color><TextAlign>Right</TextAlign></Style></Textbox>
        </ReportItems>
      </PageFooter>

      <Page>
        <PageWidth>21.59cm</PageWidth><PageHeight>27.94cm</PageHeight>
        <LeftMargin>1.3cm</LeftMargin><RightMargin>1.3cm</RightMargin>
        <TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>

  <rd:ReportID>a1b2c3d4-0004-0004-0004-000000000004</rd:ReportID>
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
</Report>
